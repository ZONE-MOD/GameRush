config_version=5

[application]
config/name="Dino Rush"
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/max_fps=60

[autoload]
SkinPatchService="*res://graphics/skin_patch_service.gd"
AudioManager="*res://audio/audio_manager.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0
window/frame_pacing/android/enable_frame_pacing=true
window/energy_saving/keep_screen_on=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.025, 0.018, 0.045, 1)

[physics]
2d/default_gravity=980.0
